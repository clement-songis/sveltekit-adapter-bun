		"format": "oxfmt --write ."
	},
	"devDependencies": {
		"@sveltejs/kit": "^3.1.1",
		"@types/node": "^24.19.2",
		"oxfmt": "^0.75.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.5"
	},
	"dependencies": {
		"bun-types": "^1.3.14"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^3.0.0-next.0"
