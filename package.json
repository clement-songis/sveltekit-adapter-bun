{
	"name": "@chtibizoux/sveltekit-adapter-bun",
	"version": "1.0.0-ws.1",
	"description": "Fork of @sveltejs/adapter-bun with WebSocket support",
	"keywords": [
		"adapter",
		"bun",
		"deploy",
		"hosting",
		"svelte",
		"sveltekit",
		"websocket"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/clement-songis/sveltekit-adapter-bun.git"
	},
	"license": "MIT",
	"homepage": "https://svelte.dev/docs/kit/adapter-bun",
	"type": "module",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"import": "./index.js"
		},
		"./package.json": "./package.json"
	},
	"types": "index.d.ts",
	"files": [
